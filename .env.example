# ── App ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=*
# Public URL of the web app (frontend); invite links are <APP_URL>/invite/<code>
APP_URL=http://localhost:3000

# ── Database (MySQL) ────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=password
DB_DATABASE=nestjs_app
# Create and update tables automatically from the entities on startup.
# Set to false in production and use migrations: renaming or removing an entity
# property makes sync drop that column and its data.
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_RUN_MIGRATIONS=false

# ── Auth ────────────────────────────────────────────
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Access tokens are short-lived; clients renew them with POST /auth/refresh.
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
# Password reset: code lifetime, wrong guesses allowed, reset-token lifetime
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
RESET_TOKEN_TTL_SECONDS=900

# ── Mail (SMTP) ─────────────────────────────────────
# Leave SMTP_HOST empty to print emails (incl. reset codes) to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=NestJS App <no-reply@example.com>

# ── Uploads ─────────────────────────────────────────
MAX_FILE_SIZE_MB=5
MAX_TRIP_IMAGES=30

# ── Google Places (city search, hotel suggestions) ──
# Enable "Places API (New)" in Google Cloud and create an API key restricted to it.
# Leave empty to turn the /places endpoints off (they answer 503).
GOOGLE_PLACES_API_KEY=

# ── Firebase Cloud Messaging (optional) ─────────────
# One-line Firebase service-account JSON. Do not commit the real value.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── First admin (used by `npm run seed:admin`) ──────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123

# ── Swagger ─────────────────────────────────────────
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
